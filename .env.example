# ===========================================
# KipuSalud - Environment Configuration
# ===========================================
# Copy this file to .env and provide unique secrets before starting the stack.
# Usage: docker compose --env-file .env up -d

# ===================
# PostgreSQL Configuration
# ===================
POSTGRES_HOST=psql
POSTGRES_PORT=5432
POSTGRES_USER=kipusalud
POSTGRES_PASSWORD=

# ===================
# RabbitMQ Configuration
# ===================
RABBITMQ_USER=kipusalud
RABBITMQ_PASSWORD=

# ===================
# JWT Configuration
# ===================
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=86400000

# ===================
# Temporary demo accounts
# ===================
# Keep disabled unless the public demo is intentionally enabled.
DEMO_SESSIONS_ENABLED=false
DEMO_SESSION_TTL_MINUTES=60

# ===================
# Browser CORS origins (comma-separated, exact origins only)
# ===================
# Include the public application URL, e.g. https://kipusalud.pe
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ===================
# SUNAT electronic invoicing
# ===================
# Generate with: openssl rand -base64 32
# Keep stable while encrypted SUNAT credentials exist; rotate only with re-encryption.
SUNAT_MASTER_KEY=
SUNAT_ENVIRONMENT=BETA
SUNAT_BETA_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_PRODUCTION_URL=
SUNAT_PRODUCTION_ENABLED=false
