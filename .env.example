# ===========================================
# KipuSalud - Environment Configuration
# ===========================================
# Copy this file to .env and adjust values as needed
# Usage: docker compose --env-file .env up -d

# ===================
# PostgreSQL Configuration
# ===================
POSTGRES_HOST=psql
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ===================
# RabbitMQ Configuration
# ===================
RABBITMQ_USER=kipusalud
RABBITMQ_PASSWORD=change-me

# ===================
# JWT Configuration
# ===================
JWT_SECRET=KipuSaludSecretKeyForJwtTokenSigningWithHS256Algorithm2026
JWT_EXPIRATION=86400000

# ===================
# SUNAT electronic invoicing
# ===================
# Generate with: openssl rand -base64 32
# Keep stable and store it in a secret manager in deployed environments.
SUNAT_MASTER_KEY=
SUNAT_ENVIRONMENT=BETA
SUNAT_BETA_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_PRODUCTION_URL=
SUNAT_PRODUCTION_ENABLED=false
